FROM oven/bun:1.3.10-alpine AS dependencies

WORKDIR /app

COPY package.json bun.lock ./
COPY packages/server/package.json packages/server/package.json
COPY packages/web/package.json packages/web/package.json
RUN bun install --frozen-lockfile --production --ignore-scripts

FROM oven/bun:1.3.10-alpine

WORKDIR /workspace

COPY --from=dependencies --chown=bun:bun /app/node_modules /app/node_modules
COPY --from=dependencies --chown=bun:bun /app/packages/server/node_modules /app/packages/server/node_modules
COPY --chown=bun:bun packages/server/package.json /app/packages/server/package.json
COPY --chown=bun:bun packages/server/src /app/packages/server/src
COPY --chown=bun:bun packages/web/package.json /app/packages/web/package.json
COPY --chown=bun:bun packages/web/src/index.ts /app/packages/web/src/index.ts
COPY --chown=bun:bun packages/web/dist /app/packages/web/dist

USER bun
EXPOSE 3000

ENTRYPOINT ["bun", "/app/packages/server/src/index.ts"]
CMD ["--project", "/workspace"]
