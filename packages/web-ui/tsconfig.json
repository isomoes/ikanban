{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "@deepseek-ai/dsh-client-web": ["./src/client/web/boot.tsx"],
      "@deepseek-ai/dsh-client-web-react": ["./src/client/web-react/index.ts"],
      "@deepseek-ai/dsh-client-ui-slots": ["./src/client/ui-slots/index.ts"],
      "@deepseek-ai/dsh-client-ui-primitives": ["./src/client/ui-primitives/index.ts"],
      "@deepseek-ai/dsh-client-ui-attachment": ["./src/client/ui-attachment/index.ts"],
      "@deepseek-ai/dsh-client-schema-form": ["./src/client/schema-form/index.ts"],
      "@deepseek-ai/dsh-client-locale/client": ["./src/client/locale/client/index.ts"],
      "@deepseek-ai/dsh-client-ui-*/client": ["./src/client/ui-*/client/index.ts"],
      "@deepseek-ai/dsh-client-ui-cordis/client": ["./src/extensions/ui-cordis/client/index.ts"]
    }
  },
  "include": [
    "vite.config.ts",
    "tsdown.config.ts",
    "src/css-modules.d.ts",
    "src/node-module-stub.ts",
    "src/main.ts",
    "src/client/web",
    "src/client/web-react",
    "src/client/ui-slots",
    "src/client/ui-primitives",
    "src/client/ui-attachment",
    "src/client/schema-form",
    "src/client/locale/client",
    "src/client/ui-*/client",
    "src/extensions/ui-cordis/client"
  ]
}
