{
  "name": "@isomoes/dsh-ikanban",
  "version": "0.4.1",
  "description": "Keyboard-oriented iKanban web application bundle for DeepSeek Harness",
  "keywords": [
    "ikanban",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "coding-agent",
    "developer-tools",
    "keyboard-first"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./hmr": {
      "types": "./lib/types/hmr.d.ts",
      "default": "./lib/hmr.js"
    },
    "./directory-picker-auto": {
      "types": "./lib/types/directory-picker-auto.d.ts",
      "default": "./lib/directory-picker-auto.js"
    },
    "./client/*/client": "./lib/clients/*/client.js",
    "./client/*/package.json": "./lib/clients/*/package.json",
    "./client/*": "./lib/clients/*/index.js",
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/types/**/*.d.ts",
    "lib/clients/**/package.json",
    "lib/web/**",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isomoes/ikanban.git",
    "directory": "packages/ikanban"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "build": "pnpm --filter @isomoes/dsh-ikanban-web-ui build:package && pnpm build:package",
    "build:package": "node scripts/clean.mjs && pnpm sync:upstream && tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-remotes": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-app-boot": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-hmr": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-modules": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-cordis-client-runner": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-cordis-host-runner": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-apiproxy": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-directory-picker-browse": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-frontend-static": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-plugin-inventory": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-message-feedback": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-log-export": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-projection-cache": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session-stats": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-storage": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-domain": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-storage-json": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell-env": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-invariants": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-shell-env": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-web-app": "^0.1.0-rc.6",
    "@isomoes/dsh-ikanban-web-ui": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.3"
  }
}
