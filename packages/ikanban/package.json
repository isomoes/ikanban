{
  "name": "@isomoes/dsh-ikanban",
  "version": "0.5.3",
  "description": "Keyboard-oriented iKanban web application bundle for DeepSeek Harness",
  "keywords": [
    "ikanban",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "coding-agent",
    "developer-tools",
    "keyboard-first"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./hmr": {
      "types": "./lib/types/hmr.d.ts",
      "default": "./lib/hmr.js"
    },
    "./directory-picker-auto": {
      "types": "./lib/types/directory-picker-auto.d.ts",
      "default": "./lib/directory-picker-auto.js"
    },
    "./project-mcp": {
      "types": "./lib/types/project-mcp.d.ts",
      "default": "./lib/project-mcp.js"
    },
    "./file-reference-local": {
      "types": "./lib/types/file-reference-local.d.ts",
      "default": "./lib/file-reference-local.js"
    },
    "./session-reference": {
      "types": "./lib/types/session-reference.d.ts",
      "default": "./lib/session-reference.js"
    },
    "./ikanban-preset": {
      "types": "./lib/types/ikanban-preset.d.ts",
      "default": "./lib/ikanban-preset.js"
    },
    "./markdown-command": {
      "types": "./lib/types/markdown-command.d.ts",
      "default": "./lib/markdown-command.js"
    },
    "./project-mcp.preset.yml": "./project-mcp.preset.yml",
    "./client/*/client": "./lib/clients/*/client.js",
    "./client/*/package.json": "./lib/clients/*/package.json",
    "./client/*": "./lib/clients/*/index.js",
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/clients/**/package.json",
    "lib/web/**",
    "!lib/**/*.js.map",
    "cordis.patch.yml",
    "project-mcp.preset.yml",
    "preset/ikanban/**"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isomoes/ikanban.git",
    "directory": "packages/ikanban"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "pnpm --filter @isomoes/dsh-project-mcp build:package && pnpm --filter @isomoes/dsh-web-ui build:package && pnpm build:package",
    "build:package": "node scripts/clean.mjs && tsc -p tsconfig.json && pnpm build:brand && node scripts/build-client.mjs && node scripts/build-project-mcp.mjs",
    "build:brand": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-loop": "^0.1.2-alpha.2",
