{
  "name": "@isomoes/dsh-ikanban-root",
  "version": "0.4.1",
  "private": true,
  "description": "iKanban workspace",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isomoes/ikanban.git"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build:package",
    "dev": "pnpm dev:install && node scripts/dev.mjs",
    "dev:config": "dsh --profile ikanban-dev --dump-config",
    "dev:install": "IKANBAN_DEV=1 pnpm build && dsh plugin --profile ikanban-dev add ./packages/ikanban",
    "dev:remove": "dsh plugin --profile ikanban-dev remove @isomoes/dsh-ikanban",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test"
  }
}
