{
  "name": "ikanban",
  "version": "0.6.0",
  "description": "iKanban standalone frontend for OpenCode V2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.12",
  "workspaces": [
    "packages/web"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/isomoes/ikanban"
  },
  "scripts": {
    "dev": "bun run --cwd packages/web dev",
    "dev:web": "bun run --cwd packages/web dev",
    "build": "bun run build:web",
    "build:web": "bun run --cwd packages/web build",
    "dev:web:watch": "bun run --cwd packages/web build:watch",
    "preview:web": "bun run --cwd packages/web preview",
    "typecheck": "bun run --cwd packages/web typecheck",
    "type-check": "bun run typecheck",
    "bump-version": "node scripts/bump-version.mjs"
  }
}
