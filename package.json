{
  "name": "ikanban-workspace",
  "version": "0.3.17",
  "description": "iKanban workspace",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/isomoes/ikanban"
  },
  "scripts": {
    "dev": "bun run build:web && bun --watch packages/server/src/index.ts",
    "test:server": "bun test packages/server/src",
    "build": "bun run build:web && bun run --cwd packages/server type-check",
    "build:web": "VITE_BASE_PATH=/ikanban/ bun run --cwd packages/web build",
    "start": "bun packages/server/src/index.ts",
    "type-check": "bun run --filter '*' type-check",
    "type-check:web": "bun run --cwd packages/web type-check",
    "postinstall": "patch-package",
    "dev:web": "bun run --cwd packages/web dev",
    "dev:web:watch": "bun run --cwd packages/web build:watch",
    "bump-version": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "typescript": "~5.9.3"
  }
}
